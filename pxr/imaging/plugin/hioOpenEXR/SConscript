mfb.PrivateCFiles('''
	OpenEXR/openexr-c.c
''')

# Hide symbols and inlines in the C code (mirrors CMakeLists.txt's
# $<$<COMPILE_LANGUAGE:C>:-fvisibility=hidden>, which SCons gives us for
# free since CFLAGS only reaches the C builder, not the C++ builder).
mfb.CFlags('-fvisibility=hidden')

mfb.PrivateCPPFiles('''
	OpenEXRImage.cpp
	OpenEXR/OpenEXRCore/internal_ht_common.cpp
''')

mfb.ResourceFiles('''plugInfo.json''')

mfb.InstallTestSpec('testSpecs.xml')

mfb.BuildTest('testHioOpenEXR',
              '''
              testenv/testHioOpenEXR.cpp
              ''',
              reqlibs='''pxr/base/tf
                         pxr/imaging/hio
              ''',
              syslibs='''
                         ''')

mfb.InstallTestDir('testHioOpenEXR',
                   'testenv/testHioOpenEXR')

mfb.EndPackage()
