Import('mfb')

overrideIncludePaths = ['${PX_CONFIG_PACKAGE_NAME}']
overrideIncludePaths.append(Dir('.').abspath)

mfb.BeginPackage(owner=["tools-team-gpu@pixar.com"],
                 description='Hydra plugin for reading OpenEXR image files',
                 overrideIncludePath=' '.join(overrideIncludePaths))

mfb.Libraries(
    '''
    pxr/base/arch
    pxr/base/gf
    pxr/base/plug
    pxr/base/tf
    pxr/base/vt
    pxr/imaging/hio
    ''')

mfb.SystemLibraries(
    '''
    ''')

mfb.PrivateHeaders('''
	pch.h
	OpenEXR/openexr-c.h
	OpenEXR/deflate/common_defs.h
	OpenEXR/deflate/lib/bt_matchfinder.h
	OpenEXR/deflate/lib/matchfinder_common.h
	OpenEXR/deflate/lib/zlib_constants.h
	OpenEXR/deflate/lib/decompress_template.h
	OpenEXR/deflate/lib/ht_matchfinder.h
	OpenEXR/deflate/lib/deflate_compress.h
	OpenEXR/deflate/lib/x86/decompress_impl.h
	OpenEXR/deflate/lib/x86/cpu_features.h
	OpenEXR/deflate/lib/x86/adler32_impl.h
	OpenEXR/deflate/lib/x86/matchfinder_impl.h
	OpenEXR/deflate/lib/lib_common.h
	OpenEXR/deflate/lib/hc_matchfinder.h
